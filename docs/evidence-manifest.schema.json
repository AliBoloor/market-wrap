{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aliboloor.github.io/market-wrap/schemas/evidence-manifest-v1.json",
  "title": "Market Wrap evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "trading_date", "report_type", "generated_at", "market_data_as_of", "state", "sources", "series_files", "chart_files", "warnings"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "trading_date": {"type": "string", "format": "date"},
    "report_type": {"enum": ["Pre-market", "Intraday update", "Closing Market Wrap", "Market holiday"]},
    "generated_at": {"type": "string", "format": "date-time"},
    "market_data_as_of": {"type": "string", "format": "date-time"},
    "state": {"enum": ["draft", "validated", "published", "failed"]},
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_id", "title", "url", "publisher", "accessed_at", "supports"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "url": {"type": "string", "format": "uri"},
          "publisher": {"type": "string", "minLength": 1},
          "accessed_at": {"type": "string", "format": "date-time"},
          "supports": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    },
    "series_files": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "chart_files": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "warnings": {"type": "array", "items": {"type": "string"}}
  }
}
